# Public Supabase project configuration. These values are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only; reserved for future authorized administrative operations.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only Google Drive OAuth configuration for the KWD official account.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# JSON object of exact Admin destination keys to Drive folder IDs.
# Key forms: ADMIN|YEAR|CATEGORY|SUBCATEGORY or ADMIN|REFERENCE & TEMPLATES
GOOGLE_DRIVE_ADMIN_FOLDER_MAP=

# Optional. Defaults to the deployment-safe 4 MiB request limit (4194304).
ADMIN_UPLOAD_MAX_BYTES=
